# ESP8266 是单核 RTOS，FreeRTOS 必须配置成单核模式
CONFIG_FREERTOS_UNICORE=y

# Flash 1MB（WeMos D1 mini 默认）
CONFIG_ESPTOOLPY_FLASHSIZE_1MB=y

# 关闭不需要的组件，节省资源
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# WiFi SSID / Password 通过 menuconfig 设置
# 运行 `idf.py menuconfig` -> "PC Power Control Configuration"
CONFIG_WIFI_SSID="MyWiFi"
CONFIG_WIFI_PASSWORD="MyPassword"
